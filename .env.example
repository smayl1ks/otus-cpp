# Backend runner image. Leave unset to pull ghcr.io/smayl1ks/otus-cpp/runner:latest
#RUNNER_IMAGE=ghcr.io/smayl1ks/otus-cpp/runner:latest

# Database
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5434

REDIS_NUM_SHARDS=2
REDIS_MASTER_NAME=master
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
#REDIS_HOST=redis
#REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECTION_TIMEOUT_MS=2000

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Auth
JWT_ACCESS_SECRET=random_hex
