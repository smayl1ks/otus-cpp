# Database
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5434

# Redis Configuration (externalized for dynamic shard scaling)
REDIS_NUM_SHARDS=1
REDIS_POOL_SIZE=2
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=redis_sentinel:26379
REDIS_PASSWORD=secret_redis_password
REDIS_CONNECTION_TIMEOUT_MS=100
REDIS_COMMAND_TIMEOUT_MS=50
REDIS_TTL_REFRESH_INTERVAL_SEC=30

# Dedicated Pub/Sub fleet (radar), client-side channel sharding by h3_zone.
# Leave hosts empty to fall back to publishing through the sharded masters.
# Comma-separated: REDIS_PUBSUB_HOSTS=redis_pubsub_0:6379,redis_pubsub_1:6379
REDIS_PUBSUB_HOSTS=redis_pubsub_0:6379,redis_pubsub_1:6379
REDIS_PUBSUB_PORT=6379
REDIS_PUBSUB_PASSWORD=secret_redis_password

# Buffer Configuration
BUFFER_IN_MEMORY_CAPACITY=16384
BUFFER_DRAIN_BATCH_SIZE=512

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443
